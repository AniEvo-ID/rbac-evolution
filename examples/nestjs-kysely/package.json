{
  "name": "rbac-evolution-example-nestjs-kysely",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "rbac-evolution example: NestJS 12 API + Kysely (SQLite via libsql), routes guarded with the NestJS decorators.",
  "scripts": {
    "db:setup": "tsx src/seed.ts",
    "dev": "tsx watch src/main.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo data"
  },
  "dependencies": {
    "@anievo-id/rbac-evolution": "workspace:*",
    "@anievo-id/rbac-evolution-kysely": "workspace:*",
    "@anievo-id/rbac-evolution-nestjs": "workspace:*",
    "@libsql/kysely-libsql": "^0.4.1",
    "@nestjs/common": "^12.5.0",
    "@nestjs/core": "^12.5.0",
    "@nestjs/platform-express": "^12.5.0",
    "kysely": "^0.28.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.20.5",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
