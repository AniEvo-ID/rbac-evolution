{
  "name": "rbac-evolution-example-vue-express",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "rbac-evolution example: Express 5 API + Drizzle (SQLite) + Vue 3 SPA.",
  "scripts": {
    "db:setup": "tsx server/seed.ts",
    "dev": "concurrently -n api,web -c blue,green \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build && tsup",
    "start": "node dist/server/index.js",
    "typecheck": "vue-tsc --noEmit",
    "clean": "rm -rf dist .turbo data"
  },
  "dependencies": {
    "@anievo-id/rbac-evolution": "workspace:*",
    "@anievo-id/rbac-evolution-drizzle": "workspace:*",
    "@anievo-id/rbac-evolution-express": "workspace:*",
    "@libsql/client": "^0.15.0",
    "drizzle-orm": "^0.44.0",
    "express": "^5.0.0"
  },
  "devDependencies": {
    "@anievo-id/rbac-evolution-vue": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^5.2.0",
    "concurrently": "^9.1.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^5.4.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0",
    "vue-tsc": "^2.2.0"
  }
}
