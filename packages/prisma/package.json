{
  "name": "@anievo-id/rbac-evolution-prisma",
  "version": "1.1.0",
  "description": "Prisma storage adapter for rbac-evolution.",
  "license": "MIT",
  "author": "AniEvo-ID (https://github.com/AniEvo-ID)",
  "homepage": "https://creation.anievo.id/rbac-evolution/adapters/prisma",
  "bugs": {
    "url": "https://github.com/AniEvo-ID/rbac-evolution/issues"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AniEvo-ID/rbac-evolution.git",
    "directory": "packages/prisma"
  },
  "keywords": [
    "rbac",
    "permissions",
    "roles",
    "authorization",
    "prisma"
  ],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "node test/prepare.mjs --generate-only && tsc --noEmit",
    "test:db": "node test/prepare.mjs",
    "test": "node test/prepare.mjs && vitest run",
    "clean": "rm -rf dist .turbo test/generated test/generated-legacy test/generated-pg test/generated-mysql test/.tmp"
  },
  "dependencies": {
    "@anievo-id/rbac-evolution": "workspace:^"
  },
  "peerDependencies": {
    "@prisma/client": "^5.12.0 || ^6.0.0"
  },
  "devDependencies": {
    "@prisma/client": "^6.19.0",
    "prisma": "^6.19.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
