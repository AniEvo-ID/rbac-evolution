{
  "name": "@anievo-id/rbac-evolution-tanstack-start",
  "version": "1.8.0",
  "description": "TanStack Start guards for rbac-evolution: server functions, middleware and server routes, and a snapshot for <RbacProvider>.",
  "license": "MIT",
  "author": "AniEvo-ID (https://github.com/AniEvo-ID)",
  "homepage": "https://creation.anievo.id/rbac-evolution/frameworks/tanstack-start",
  "bugs": {
    "url": "https://github.com/AniEvo-ID/rbac-evolution/issues"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AniEvo-ID/rbac-evolution.git",
    "directory": "packages/tanstack-start"
  },
  "keywords": [
    "rbac",
    "permissions",
    "roles",
    "authorization",
    "tanstack",
    "tanstack-start",
    "server-functions",
    "middleware"
  ],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@anievo-id/rbac-evolution": "workspace:^"
  },
  "devDependencies": {
    "@tanstack/router-core": "^1.171.39",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
