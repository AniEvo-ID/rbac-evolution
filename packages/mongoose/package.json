{
  "name": "@anievo-id/rbac-evolution-mongoose",
  "version": "0.4.1",
  "description": "Mongoose (MongoDB) storage adapter for rbac-evolution.",
  "license": "MIT",
  "author": "AniEvo-ID (https://github.com/AniEvo-ID)",
  "homepage": "https://github.com/AniEvo-ID/rbac-evolution/tree/main/packages/mongoose#readme",
  "bugs": {
    "url": "https://github.com/AniEvo-ID/rbac-evolution/issues"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AniEvo-ID/rbac-evolution.git",
    "directory": "packages/mongoose"
  },
  "keywords": [
    "rbac",
    "permissions",
    "roles",
    "authorization",
    "mongoose",
    "mongodb"
  ],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@anievo-id/rbac-evolution": "workspace:^"
  },
  "peerDependencies": {
    "mongoose": ">=8"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.1.0",
    "mongoose": "^8.9.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
