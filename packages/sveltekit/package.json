{
  "name": "@anievo-id/rbac-evolution-sveltekit",
  "version": "1.3.0",
  "description": "SvelteKit integration for rbac-evolution: a handle hook, guards for loads, form actions & endpoints, and Svelte 5 components.",
  "license": "MIT",
  "author": "AniEvo-ID (https://github.com/AniEvo-ID)",
  "homepage": "https://creation.anievo.id/rbac-evolution/frameworks/sveltekit",
  "bugs": {
    "url": "https://github.com/AniEvo-ID/rbac-evolution/issues"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AniEvo-ID/rbac-evolution.git",
    "directory": "packages/sveltekit"
  },
  "keywords": [
    "rbac",
    "permissions",
    "roles",
    "authorization",
    "svelte",
    "sveltekit",
    "svelte5",
    "runes"
  ],
  "sideEffects": false,
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "private": true,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "svelte-package -i src -o dist",
    "dev": "svelte-package -i src -o dist --watch",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .svelte-kit .turbo"
  },
  "dependencies": {
    "@anievo-id/rbac-evolution": "workspace:^"
  },
  "peerDependencies": {
    "@sveltejs/kit": ">=2",
    "svelte": ">=5"
  },
  "devDependencies": {
    "@sveltejs/kit": "^2.70.4",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^4.0.4",
    "@testing-library/svelte": "^5.4.2",
    "jsdom": "^25.0.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^5.7.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
