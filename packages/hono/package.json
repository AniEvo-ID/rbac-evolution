{
  "name": "@anievo-id/rbac-evolution-hono",
  "version": "1.4.0",
  "description": "Hono middleware for rbac-evolution — runs on Node, Bun, Deno, Cloudflare Workers and other edge runtimes.",
  "license": "MIT",
  "author": "AniEvo-ID (https://github.com/AniEvo-ID)",
  "homepage": "https://creation.anievo.id/rbac-evolution/frameworks/hono",
  "bugs": {
    "url": "https://github.com/AniEvo-ID/rbac-evolution/issues"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AniEvo-ID/rbac-evolution.git",
    "directory": "packages/hono"
  },
  "keywords": [
    "rbac",
    "permissions",
    "roles",
    "authorization",
    "hono",
    "middleware",
    "edge",
    "cloudflare-workers",
    "bun"
  ],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@anievo-id/rbac-evolution": "workspace:^"
  },
  "peerDependencies": {
    "hono": ">=4"
  },
  "devDependencies": {
    "hono": "^4.6.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
