{
  "name": "@anievo-id/rbac-evolution-trpc",
  "version": "1.5.0",
  "description": "tRPC middleware for rbac-evolution — permission and role guards for procedures, with a narrowed ctx.rbac.",
  "license": "MIT",
  "author": "AniEvo-ID (https://github.com/AniEvo-ID)",
  "homepage": "https://creation.anievo.id/rbac-evolution/frameworks/trpc",
  "bugs": {
    "url": "https://github.com/AniEvo-ID/rbac-evolution/issues"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AniEvo-ID/rbac-evolution.git",
    "directory": "packages/trpc"
  },
  "keywords": [
    "rbac",
    "permissions",
    "roles",
    "authorization",
    "trpc",
    "middleware",
    "procedure",
    "nextjs"
  ],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@anievo-id/rbac-evolution": "workspace:^"
  },
  "peerDependencies": {
    "@trpc/server": ">=11"
  },
  "devDependencies": {
    "@trpc/client": "~11.26.0",
    "@trpc/server": "~11.26.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
