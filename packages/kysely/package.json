{
  "name": "@anievo-id/rbac-evolution-kysely",
  "version": "0.6.6",
  "description": "Kysely storage adapter (PostgreSQL, MySQL, SQLite & SQL Server) for rbac-evolution.",
  "license": "MIT",
  "author": "AniEvo-ID (https://github.com/AniEvo-ID)",
  "homepage": "https://creation.anievo.id/rbac-evolution/adapters/kysely",
  "bugs": {
    "url": "https://github.com/AniEvo-ID/rbac-evolution/issues"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AniEvo-ID/rbac-evolution.git",
    "directory": "packages/kysely"
  },
  "keywords": [
    "rbac",
    "permissions",
    "roles",
    "authorization",
    "kysely",
    "postgresql",
    "mysql",
    "sqlite",
    "mssql",
    "libsql"
  ],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@anievo-id/rbac-evolution": "workspace:^"
  },
  "peerDependencies": {
    "kysely": ">=0.27"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@libsql/kysely-libsql": "^0.4.1",
    "@types/pg": "^8.11.0",
    "kysely": "^0.28.0",
    "kysely-pglite-dialect": "^1.1.0",
    "mysql2": "^3.11.0",
    "pg": "^8.13.0",
    "tarn": "^3.1.2",
    "tedious": "^20.3.9",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
