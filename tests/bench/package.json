{
  "name": "rbac-evolution-bench",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "On-demand benchmarks (vitest bench) for the engine on the memory adapter and on SQLite. Not part of `pnpm test`.",
  "scripts": {
    "bench": "vitest bench --run",
    "typecheck": "tsc --noEmit",
    "bench:summary": "node summary.mjs bench.json"
  },
  "dependencies": {
    "@anievo-id/rbac-evolution": "workspace:*",
    "@anievo-id/rbac-evolution-drizzle": "workspace:*",
    "@libsql/client": "^0.15.0",
    "drizzle-orm": "^0.44.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "vitest": "^2.1.0",
    "typescript": "^5.7.0"
  }
}
