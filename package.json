{
  "name": "rbac-evolution",
  "private": true,
  "description": "Role & permission management (RBAC) for the JavaScript/TypeScript ecosystem — inspired by spatie/laravel-permission.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AniEvo-ID/rbac-evolution.git"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "node scripts/check-npm-names.mjs && turbo run build --filter=./packages/* && changeset publish",
    "api:inventory": "node scripts/list-exports.mjs",
    "api:snapshot": "node scripts/api-snapshot.mjs",
    "api:check": "node scripts/api-snapshot.mjs --check",
    "docs:api": "pnpm --filter @anievo-id/rbac-evolution-docs api",
    "lint:packages": "node scripts/lint-packages.mjs",
    "doc:test": "node scripts/doc-tests.mjs",
    "size": "size-limit"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@size-limit/preset-small-lib": "14.3.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "2.1.9",
    "publint": "^0.3.25",
    "size-limit": "14.3.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  }
}
