{
  "name": "rbac-evolution",
  "private": true,
  "description": "Role & permission management (RBAC) for the JavaScript/TypeScript ecosystem — inspired by spatie/laravel-permission.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AniEvo-ID/rbac-evolution.git"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build --filter=./packages/* && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@types/node": "^22.20.5",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  }
}
